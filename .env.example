PORT=3000
HOST=127.0.0.1
# demo | huggingface | local
AI_PROVIDER=demo
HF_TOKEN=
# Choose a currently available vision model on Hugging Face Inference Providers.
HF_MODEL=
# OpenAI-compatible vision endpoint; reachable by the backend machine.
LOCAL_AI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=

# Longer deadline for local vision; concise responses reduce generation work.
AI_TIMEOUT_MS=180000
AI_MAX_TOKENS=700
# Deadline for automatic local drawing suggestions (maximum 60 seconds).
LIVE_COACH_TIMEOUT_MS=30000

# Separate text-to-image model for new references. Qwen-VL is a vision model.
# HF_TOKEN above needs Inference Providers permission (or use HF_IMAGE_TOKEN).
HF_IMAGE_MODEL=Qwen/Qwen-Image-2512
HF_IMAGE_PROVIDER=fal-ai
HF_IMAGE_TOKEN=
IMAGE_TIMEOUT_MS=180000
# Maximum paid generations per new reference (1 disables the quality retry).
IMAGE_MAX_ATTEMPTS=2
